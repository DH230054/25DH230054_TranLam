@model MyStore.Web.Models.StoreOrder
@using MyStore.Web.Services
@{ViewBag.Title="Chi tiết đơn hàng";Layout="~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";}
<div class="admin-heading"><div><p class="overline">ORDER DETAILS</p><h1>CHI TIẾT ĐƠN HÀNG #@Model.OrderID</h1></div></div>
<div class="admin-box">
    <div class="details-grid">
        <p><b>Ngày đặt:</b> @Model.OrderDate.ToString("dd/MM/yyyy")</p>
        <p><b>Tên khách hàng:</b> @Model.Customer.CustomerName</p>
        <p><b>Phương thức thanh toán:</b> @Model.PaymentMethod</p>
        <p><b>Trạng thái thanh toán:</b> @OrderLabels.Payment(Model.PaymentStatus)</p>
        <p><b>Phương thức giao hàng:</b> @ShippingOptions.Name(Model.DeliveryMethod)</p>
        <p><b>Trạng thái đơn:</b> @OrderLabels.Status(Model.OrderStatus)</p>
        <p><b>Địa chỉ giao hàng:</b> @Model.ShippingAddress</p>
    </div>
    <div class="orders-table-scroll"><table class="admin-table"><thead><tr><th>Sản phẩm</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody>
    @foreach(var d in Model.OrderDetails)
    {
        <tr><td><div class="admin-product-mini">
        @if(d.Product != null && !string.IsNullOrWhiteSpace(ProductImageHelper.Resolve(d.Product.ProductName,d.Product.ProductImage)))
        {
            <img alt="Ảnh sản phẩm" src="@Url.Content(ProductImageHelper.Resolve(d.Product.ProductName,d.Product.ProductImage))" />
        }
        <span>@(d.Product==null?"Sản phẩm đã ngừng bán":d.Product.ProductName)</span></div></td>
        <td>@d.Quantity</td><td>@d.UnitPrice.ToString("N0")₫</td><td>@((d.Quantity*d.UnitPrice).ToString("N0"))₫</td></tr>
    }
    </tbody></table></div>
    <div class="order-total-panel"><p>Tiền hàng: <strong>@((Model.TotalAmount-Model.ShippingFee).ToString("N0"))₫</strong></p>
    <p>Phí giao hàng: <strong>@Model.ShippingFee.ToString("N0")₫</strong></p>
    <h2>TỔNG THANH TOÁN: @Model.TotalAmount.ToString("N0")₫</h2></div>
    <div class="admin-order-actions">
        @if(Model.OrderStatus!="Cancelled" && Model.OrderStatus!="Delivered")
        {
            <a class="button primary" href="@Url.Action("UpdateStatus",new{id=Model.OrderID})">Cập nhật trạng thái</a>
        }
        @if(Model.OrderStatus=="Pending")
        {
            using(Html.BeginForm("Cancel","Orders",FormMethod.Post,new{@class="inline-form"}))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("id",Model.OrderID)
                <button class="button danger-bg" onclick="return confirm('Hủy đơn và hoàn lại tồn kho?')" type="submit">Hủy đơn</button>
            }
        }
        <a class="button" href="@Url.Action("Index")">Quay lại danh sách</a>
    </div>
</div>
