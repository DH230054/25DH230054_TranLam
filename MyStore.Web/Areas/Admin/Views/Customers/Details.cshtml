@model MyStore.Web.Models.Customer
@{ViewBag.Title="Chi tiết khách hàng";Layout="~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";}
<div class="admin-heading"><h1>Khách hàng: @Model.CustomerName</h1></div><div class="admin-box"><p><strong>Username:</strong> @Model.Username</p><p><strong>SĐT:</strong> @Model.CustomerPhone</p>
<p><strong>Email:</strong> @Model.CustomerEmail</p><p><strong>Địa chỉ:</strong> @Model.CustomerAddress</p><h2>Đơn hàng</h2>
<table class="admin-table"><thead><tr><th>Mã đơn</th><th>Ngày</th><th>Giá trị</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach(var o in Model.Orders.OrderByDescending(x=>x.OrderID)){<tr><td>#@o.OrderID</td><td>@o.OrderDate.ToString("dd/MM/yyyy")</td><td>@o.TotalAmount.ToString("N0")₫</td><td>@o.OrderStatus</td><td><a href="@Url.Action("Details","Orders",new{id=o.OrderID})">Chi tiết</a></td></tr>}
</tbody></table><a class="button" href="@Url.Action("Index")">Quay lại</a></div>
