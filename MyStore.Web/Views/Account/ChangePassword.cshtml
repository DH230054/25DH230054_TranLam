@model MyStore.Web.Models.ChangePasswordVM
@{ViewBag.Title="Đổi mật khẩu";Layout="~/Views/Shared/_CustomerLayout.cshtml";}
<div class="card auth-card"><h1>Đổi mật khẩu</h1>
@using(Html.BeginForm()){@Html.AntiForgeryToken()@Html.ValidationSummary(false,"",new{@class="text-error"})
@Html.LabelFor(x=>x.OldPassword)@Html.PasswordFor(x=>x.OldPassword,new{@class="form-control"})
@Html.LabelFor(x=>x.NewPassword)@Html.PasswordFor(x=>x.NewPassword,new{@class="form-control"})
@Html.LabelFor(x=>x.ConfirmPassword)@Html.PasswordFor(x=>x.ConfirmPassword,new{@class="form-control"})
<button class="btn btn-primary block">Đổi mật khẩu</button>}</div>
