@model MyStore.Web.Models.StoreOrder
@{ViewBag.Title="Xác nhận đơn hàng";Layout="~/Views/Shared/_CustomerLayout.cshtml";}
<div class="success-hero">✓<h1>Đặt hàng thành công!</h1><p>Đơn hàng #@Model.OrderID đã được tiếp nhận.</p></div>
<div class="card"><h2>Thông tin đơn #@Model.OrderID</h2><div class="two-col"><p>Ngày đặt: <strong>@Model.OrderDate.ToString("dd/MM/yyyy")</strong></p><p>Trạng thái: <strong>@MyStore.Web.Services.OrderLabels.Status(Model.OrderStatus)</strong></p>
<p>Thanh toán: <strong>@Model.PaymentMethod (@Model.PaymentStatus)</strong></p><p>Giao hàng: <strong>@MyStore.Web.Services.ShippingOptions.Name(Model.DeliveryMethod)</strong></p><p>Địa chỉ: <strong>@Model.ShippingAddress</strong></p></div>
<table class="table"><thead><tr><th>Sản phẩm</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody>
@foreach(var d in Model.OrderDetails){<tr><td>@d.Product.ProductName</td><td>@d.Quantity</td><td>@d.UnitPrice.ToString("N0")₫</td><td>@((d.Quantity*d.UnitPrice).ToString("N0"))₫</td></tr>}
</tbody></table><div class="order-costs"><p>Tiền hàng: <strong>@( (Model.TotalAmount-Model.ShippingFee).ToString("N0") )₫</strong></p><p>Phí vận chuyển: <strong>@Model.ShippingFee.ToString("N0")₫</strong></p><p class="total-right">Tổng thanh toán: <strong>@Model.TotalAmount.ToString("N0")₫</strong></p></div>
<a class="btn btn-primary" href="@Url.Action("MyOrder")">Đơn hàng của tôi</a><a class="btn btn-outline" href="@Url.Action("Index","Home")">Về trang chủ</a></div>
